{
	# Email nhận cảnh báo liên quan đến chứng chỉ TLS của Let's Encrypt.
	email {$CADDY_EMAIL}
}

(backend) {
	# Caddy tự gửi các header X-Forwarded-* cần thiết cho Spring Boot.
	reverse_proxy app:8080 {
		# This deployment uses Caddy as the ONLY public edge proxy.
		# Overwrite untrusted client-supplied forwarding headers before Spring reads them.
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
		header_up -Forwarded
		header_up -Proxy-Client-IP
		header_up -WL-Proxy-Client-IP
		header_up -HTTP_CLIENT_IP
		header_up -HTTP_X_FORWARDED_FOR
	}
}

{$LADUX_API_DOMAIN} {
    encode zstd gzip
    import backend
}

{$LADUX_WEB_DOMAIN} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }
    request_body {
        max_size 25MB
    }
    @api path /api/* /oauth2/* /login/oauth2/* /uploads/*
    handle @api {
        import backend
    }
    handle {
        reverse_proxy frontend:80
    }
}
