# LOCAL DEVELOPMENT ONLY. Copy to backend/.env; never overwrite an existing file.
# Generate DB_PASSWORD and JWT_SECRET using docs/LOCAL_SETUP.md.
SPRING_PROFILES_ACTIVE=dev
DB_HOST=postgres
DB_USERNAME=akira
DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_BASE64_RANDOM_SECRET

# Synthetic credentials let local components initialize; they do NOT authorize
# any external service. Replace each provider's complete set to test that service.
GOOGLE_CLIENT_ID=local-demo-client
GOOGLE_CLIENT_SECRET=local-demo-client-secret
OAUTH2_SUCCESS_REDIRECT=http://localhost:5173/auth/oauth2/success
OAUTH2_FAILURE_REDIRECT=http://localhost:5173/login?oauth2Error=true
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

AUTH_COOKIE_SECURE=false
AUTH_DEVICE_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Strict
CAPTCHA_ENABLED=false
CAPTCHA_SECRET=
CAPTCHA_EXPECTED_HOSTNAME=localhost
CAPTCHA_EXPECTED_ACTION=login

MAIL_USERNAME=local-demo@example.invalid
MAIL_PASSWORD=local-demo-mail-password
CONTACT_RECEIVER_EMAIL=local-demo@example.invalid

VNPAY_TMN_CODE=LOCALDEMO
VNPAY_HASH_SECRET=local-demo-signing-key-not-a-merchant-secret
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay/return
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_REFUND_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_IPN_URL=http://localhost:8080/api/v1/payments/vnpay-webhook
VNPAY_EXPIRE_MINUTES=15
# Do not query the gateway with synthetic merchant credentials.
PAYMENT_VNPAY_RECONCILIATIONENABLED=false

DEEPSEEK_API_KEY=local-demo-deepseek-key
GOOGLE_GENAI_API_KEY=local-demo-embedding-key
