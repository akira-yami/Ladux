# Same-origin API via Vite proxy supports localhost and HTTPS tunnels.
VITE_API_BASE_URL=/api/v1
# Optional: exact public frontend URL for ngrok; never allow all hosts.
LADUX_DEV_PUBLIC_URL=
VITE_ENABLE_UNSAFE_ORDER_RETURN_TRANSITIONS=false
# Required when backend CAPTCHA_ENABLED=true (reCAPTCHA v3 site key; never put the secret here).
VITE_RECAPTCHA_SITE_KEY=
