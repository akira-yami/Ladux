# Public domain managed by Caddy. DNS A/AAAA record must point to the VPS.
LADUX_WEB_DOMAIN=shop.example.com
LADUX_API_DOMAIN=api.example.com
CADDY_EMAIL=operator@example.com
LADUX_ALLOW_INDEXING=true

# Database
DB_USERNAME=ladux
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Authentication and OAuth
JWT_SECRET=REPLACE_WITH_A_BASE64_SECRET_AT_LEAST_32_BYTES
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
OAUTH2_SUCCESS_REDIRECT=https://shop.example.com/auth/oauth2/success
OAUTH2_FAILURE_REDIRECT=https://shop.example.com/login?oauth2Error=true

# Google reCAPTCHA v3: register the storefront hostname with the provider.
CAPTCHA_SECRET=REPLACE_WITH_CAPTCHA_SERVER_SECRET
CAPTCHA_EXPECTED_HOSTNAME=shop.example.com
VITE_RECAPTCHA_SITE_KEY=REPLACE_WITH_PUBLIC_CAPTCHA_SITE_KEY

# Enable only for the first deployment; remove password and disable afterwards.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=store_owner
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD_16_TO_72_BYTES

# Mail / OTP
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD

# VNPay production
VNPAY_TMN_CODE=REPLACE_WITH_VNPAY_TMN_CODE
VNPAY_HASH_SECRET=REPLACE_WITH_VNPAY_HASH_SECRET
VNPAY_PAY_URL=https://pay.vnpay.vn/vpcpay.html
VNPAY_RETURN_URL=https://shop.example.com/payment/vnpay/return
# Obtain the live transaction WebAPI URLs from the merchant agreement.
VNPAY_REFUND_URL=REPLACE_WITH_VNPAY_LIVE_TRANSACTION_API_HTTPS_URL
VNPAY_QUERY_URL=REPLACE_WITH_VNPAY_LIVE_TRANSACTION_API_HTTPS_URL
VNPAY_IPN_URL=https://api.example.com/api/v1/payments/vnpay-webhook

# AI providers
DEEPSEEK_API_KEY=REPLACE_WITH_DEEPSEEK_API_KEY
GOOGLE_GENAI_API_KEY=REPLACE_WITH_GOOGLE_GENAI_API_KEY

# Frontend origins allowed to call the API. Do not use localhost or wildcards.
APP_CORS_ALLOWED_ORIGINS=https://shop.example.com
